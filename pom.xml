<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Modelled on mysql-sakila-spring-data, which is Spring Data JPA over mysql-sakila-persistence's entities; this one
    is over heads-of-governments-persistence's. Unlike that one, it has jinahya-parent as its parent and the unified
    version, as every submodule of jakarta-persistence-applied-book-projects does.
    -->
  <parent>
    <groupId>io.github.jinahya</groupId>
    <artifactId>jinahya-parent</artifactId>
    <version>1.1.1</version>
  </parent>

  <groupId>io.github.jinahya</groupId>
  <artifactId>heads-of-governments-spring-data</artifactId>
  <version>0.6.11-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>${project.artifactId}</name>
  <description>Spring Data for the heads-of-governments database</description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git@github.com:jinahya/${project.artifactId}.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/${project.artifactId}.git</developerConnection>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      Upstream (heads-of-governments-persistence) compiles its main sources at release 17 and its tests at 25; 17 is
      therefore the floor for anything compiled against its entities. Both halves here are 25.
      -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <maven.compiler.testSource>${maven.compiler.source}</maven.compiler.testSource>
    <maven.compiler.testTarget>${maven.compiler.testSource}</maven.compiler.testTarget>
    <maven.compiler.testRelease>${maven.compiler.testSource}</maven.compiler.testRelease>
    <!--
      Keep parameter names in the class files: method validation reports them (findAllByCountry.country, not .arg0),
      and Spring Data binds named parameters by them.
      -->
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!--
      Boot 4, not 3: it manages jakarta.persistence-api 3.2, which the upstream mappings are written against
      (upstream: jakarta.jakartaee-bom 11.0.0). Boot 3.x manages 3.1. Do not downgrade.
      https://docs.spring.io/spring-boot/appendix/dependency-versions/coordinates.html
      -->
    <version.org.springframework.boot>4.1.2</version.org.springframework.boot>

    <!-- The sibling, at the unified version: `./mvnw -DskipTests install` it to pick up a change there. -->
    <version.heads-of-governments-persistence>0.6.10</version.heads-of-governments-persistence>

    <!-- The versions below are upstream's, where it names the same. -->
    <!-- https://central.sonatype.com/artifact/org.projectlombok/lombok/versions -->
    <version.org.projectlombok>1.18.48</version.org.projectlombok>
    <!-- https://central.sonatype.com/artifact/org.xerial/sqlite-jdbc/versions -->
    <version.org.xerial.sqlite-jdbc>3.53.4.0</version.org.xerial.sqlite-jdbc>
    <!--
      The test stack at the baseline of PROJECTS_VERSIONS.asciidoc, over the one Boot's BOM manages.
      https://central.sonatype.com/artifact/org.junit/junit-bom/versions
      https://central.sonatype.com/artifact/org.mockito/mockito-bom/versions
      https://central.sonatype.com/artifact/org.assertj/assertj-core/versions
      https://central.sonatype.com/artifact/ch.qos.logback/logback-classic/versions
      -->
    <version.org.junit>6.1.3</version.org.junit>
    <version.org.mockito>5.24.0</version.org.mockito>
    <version.org.assertj>4.0.0-M1</version.org.assertj>
    <version.ch.qos.logback>1.6.5</version.ch.qos.logback>
    <!-- https://central.sonatype.com/artifact/org.jspecify/jspecify/versions -->
    <version.org.jspecify>1.0.1</version.org.jspecify>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Every Spring, Boot and Hibernate version comes from here, so dependencies on them carry no <version>. A direct
        entry below beats an imported one, which is how the pins that follow it work.
        -->
      <!-- An earlier import beats a later one: JUnit's and Mockito's BOMs, first, over Boot's. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.org.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-bom</artifactId>
        <version>${version.org.mockito}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${version.org.springframework.boot}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- At the baseline, over Boot's. -->
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${version.org.assertj}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${version.ch.qos.logback}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${version.ch.qos.logback}</version>
      </dependency>

      <!-- The upstream entity jar. -->
      <dependency>
        <groupId>io.github.jinahya</groupId>
        <artifactId>heads-of-governments-persistence</artifactId>
        <version>${version.heads-of-governments-persistence}</version>
      </dependency>

      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${version.org.jspecify}</version>
      </dependency>
      <!-- Pinned over the BOM's, to upstream's. -->
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${version.org.projectlombok}</version>
      </dependency>
      <!-- Pinned over the BOM's, to upstream's, so the tests read the database through the driver upstream's do. -->
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${version.org.xerial.sqlite-jdbc}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      main =======================================================================================
      The entities, and their static metamodel, that the repositories are for. Upstream's jakarta.* dependencies are
      provided there, so none arrive transitively.
      -->
    <dependency>
      <groupId>io.github.jinahya</groupId>
      <artifactId>heads-of-governments-persistence</artifactId>
      <scope>compile</scope>
    </dependency>
    <!--
      The plain artifacts, not spring-boot-starter-data-jpa: the repositories need Spring Data JPA, not Boot, so the
      published pom names no starter. Provided; a consumer brings its own Spring Data JPA and JPA provider. The starter
      reaches the tests through spring-boot-starter-data-jpa-test. jakarta.persistence-api is declared, provided, since
      main code may use JPA types itself; spring-data-jpa does not bring it.
      -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-jpa</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!--
      Bean Validation constraints on repository method parameters (@NotBlank, @Positive, ...). The API only, provided:
      enforcing them takes a provider and @Validated, which the application brings.
      -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- @NullMarked on the package; CLASS-retained, so a consumer needs it only to read the nullness. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Main and test sources alike; a compile-time tool only, so neither packaged nor passed on. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      test starters ==============================================================================
      Boot 4 pairs each starter with a spring-boot-starter-<technology>-test, and each of those brings
      spring-boot-starter-test, so that one is not declared.
      -->
    <!-- spring-boot-starter-data-jpa, for the tests, and spring-boot-starter-test, for @SpringBootTest -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Hibernate Validator, and Boot's method validation, which enforces the repositories' constraints. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      test runtime ===============================================================================
      The driver of src/test/resources/heads_of_governments.sqlite3, a copy of upstream's, and Hibernate's
      SQLiteDialect. Test scope, so consumers get neither.
      -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.16.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!--
        Lombok on the processor path of both executions, default-compile and default-testCompile. The <path> takes its
        version from dependencyManagement, so the processor and the annotations stay in step.
        -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- Dependency convergence and the Maven version come from jinahya-parent; the JDK and the profiles from here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <!-- The build JDK: the compiler release above is 25. -->
            <id>enforce-require-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!-- A -P naming a profile that does not exist is silently ignored by Maven; this makes it a failure. -->
            <id>enforce-require-profile-ids-exist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProfileIdsExist />
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipAfterFailureCount>1</skipAfterFailureCount>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Binds maven-failsafe-plugin, which runs the *IT classes. -->
    <profile>
      <id>failsafe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <skipAfterFailureCount>1</skipAfterFailureCount>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
